// A small grammar for internal/lezer's own tests: it uses the features of
// lezer-generator that a test of the runtime needs and @lezer/java does not,
// each in its simplest form. tokens.js holds its external tokenizers,
// specializer and context tracker, which toy_test.go ports to Go.

@dialects { strict }

@precedence { call, prefix @right, times @left, plus @left, pipe @left, arrow @right }

@top Program { statement* }

@top SingleExpression { expression }

@context depth from "./tokens.js"

@external tokens spread from "./tokens.js" { Spread }

@external tokens typeName from "./tokens.js" { TypeName }

@external tokens marker from "./tokens.js" { ShallowMark, DeepMark }

@external specialize { identifier } keywords from "./tokens.js" { kwLet[@name=let], kwIf[@name=if], kwElse[@name=else] }

@external extend { identifier } contextualKeywords from "./tokens.js" { kwAs[@name=as] }

@external propSource highlighting from "./highlight.js"

statement[@isGroup=Statement] {
  LetStatement { kwLet Definition (kwAs TypeName)? "=" expression semi } |
  ForStatement { kw<"for"> Definition ckw<"of"> expression Block } |
  IfStatement { kwIf expression Block (kwElse Block)? } |
  AssertStatement { @specialize[@name=assert,@dialect=strict]<identifier, "assert"> expression semi } |
  MarkStatement { (ShallowMark | DeepMark) semi } |
  Block |
  ExpressionStatement { expression semi }
}

Block { "{" statement* "}" }

expression[@isGroup=Expression] {
  Number |
  String |
  BooleanLiteral |
  VariableName |
  ParenthesizedExpression { "(" expression ")" } |
  ArrowFunction { ParamList "=>" expression } |
  NewExpression[@dynamicPrecedence=1] { TypeName ArgList } |
  CallExpression { expression !call ArgList } |
  MemberExpression { expression !call "." PropertyName } |
  UnaryExpression { !prefix "-" expression } |
  BinaryExpression { expression !times "*" expression | expression !plus "+" expression | expression !pipe pipe expression }
}

ParamList[@dynamicPrecedence=1] { "(" commaSep<Definition> ")" }

ArgList { "(" commaSep<Spread? expression> ")" }

BooleanLiteral { @specialize<identifier, "true" | "false"> }

VariableName { identifier ~arrow }

PropertyName { identifier }

Definition { identifier ~arrow }

kw<term> { @specialize[@name={term}]<identifier, term> }

ckw<term> { @extend[@name={term}]<identifier, term> }

semi { ";" | insertedSemi }

commaSep<content> { (content ("," content)*)? }

@skip {} {
  String { '"' (stringContent | Escape | Interpolation)* stringEnd }
}

Interpolation { interpolationStart expression "}" }

@local tokens {
  stringEnd[@name='"'] { '"' }
  interpolationStart[@name="${"] { "${" }
  Escape { "\\" _ }
  @else stringContent
}

@skip { space | LineComment | BlockComment }

@tokens {
  space { $[ \t\n\r]+ }
  LineComment { "//" ![\n]* }
  BlockComment { "/*" blockCommentRest }
  blockCommentRest { ![*] blockCommentRest | "*" blockCommentAfterStar }
  blockCommentAfterStar { "/" | "*" blockCommentAfterStar | ![/*] blockCommentRest }
  identifier { $[a-zA-Z_] $[a-zA-Z_0-9]* }
  Number { $[0-9]+ }
  pipe[@dialect=strict,@name="|>"] { "|>" }
  "=" "=>" "+" "-" "*" ";" "," "."
  "(" ")" "{" "}"
  '"'
  @precedence { "=>", "=" }
}

// After @tokens, so that it only runs as a fallback once they read a token.
@external tokens insertSemicolon from "./tokens.js" { insertedSemi }

@detectDelim
